# 统一换行符，避免 Windows / Linux 之间的 CRLF 噪音
* text=auto
*.py    text eol=lf
*.md    text eol=lf
*.csv   text eol=lf
*.lean  text eol=lf
*.toml  text eol=lf
*.json  text eol=lf
*.txt   text eol=lf
# Evidence hashes must survive checkout without newline conversion.
experiments/results/guesser_dev10_5s30s_v1/** -text
experiments/results/linux_components_dev10_v1/** -text whitespace=cr-at-eol
experiments/results/guesser_frozen11_20_v1/** -text
